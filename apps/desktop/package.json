{
  "name": "@osmaref/desktop",
  "version": "0.1.5",
  "private": true,
  "description": "osu! referee client",
  "author": "A-pigeon",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/bundle-electron.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "package": "npm run build && electron-builder --win zip --config electron-builder.yml",
    "package:installer": "npm run build && electron-builder --win nsis --config electron-builder.yml"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7"
  }
}