{
  "name": "osmaref",
  "version": "0.1.7-preview.1",
  "private": true,
  "description": "osu! referee client",
  "license": "MIT",
  "author": "A-pigeon",
  "type": "commonjs",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w @osmaref/desktop",
    "build": "npm run build -w @osmaref/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build -w @osmaref/desktop && node scripts/smoke.mjs",
    "analyze:irc": "tsx scripts/analyze-irc-log.ts",
    "convert:bracket": "tsx scripts/convert-bracket.ts",
    "package": "npm run package -w @osmaref/desktop"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@radix-ui/colors": "^3.0.0",
    "electron-updater": "^6.8.11",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
